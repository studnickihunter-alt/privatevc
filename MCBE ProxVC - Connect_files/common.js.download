const scriptPath = (function () {
    if (document.currentScript) return document.currentScript.src;
    var scripts = document.getElementsByTagName('script');
    var target = 'common.js';
    for (var i = 0; i < scripts.length; i++) {
        if (scripts[i].src.indexOf(target) !== -1) {
            return scripts[i].src;
        }
    }
    return '';
})();
const commonDir = scriptPath.substring(0, scriptPath.lastIndexOf('/'));

// DOMの読み込み完了を待ってから実行
document.addEventListener('DOMContentLoaded', function () {

    // --- Domain Redirect & Canonical Link ---
    (function () {
        var hostname = window.location.hostname;
        var pathname = window.location.pathname;
        var search = window.location.search;

        var isAuthDomain = hostname === 'auth.mcproxvc.ovh';
        var isAuthPath = pathname === '/auth' || pathname.startsWith('/auth/');

        // 1. authドメインで /auth 以外にアクセスした場合はメインドメインへ転送
        if (isAuthDomain && !isAuthPath) {
            window.location.replace("https://mcproxvc.ovh" + pathname + search);
            return;
        }

        // 2. メインドメイン（または pages.dev）で /auth にアクセスした場合はauthドメインへ転送
        if (!isAuthDomain && isAuthPath) {
            window.location.replace("https://auth.mcproxvc.ovh" + pathname + search);
            return;
        }

        // 3. pages.dev からの汎用リダイレクト（上記以外）
        if (hostname.includes('pages.dev')) {
            window.location.replace("https://mcproxvc.ovh" + pathname + search);
            return;
        }

        // Canonical設定
        var link = document.createElement('link');
        link.rel = 'canonical';
        if (isAuthPath) {
            link.href = "https://auth.mcproxvc.ovh" + pathname + search;
        } else {
            link.href = "https://mcproxvc.ovh" + pathname + search;
        }
        document.head.appendChild(link);
    })();

    // --- トレイリングスラッシュ正規化 (末尾に/をつける) ---
    (function () {
        var path = window.location.pathname;
        if (path.substring(path.length - 1) !== '/' && path.lastIndexOf('.') <= path.lastIndexOf('/')) {
            var newPath = path + '/';
            var newUrl = window.location.href.replace(path, newPath);
            window.location.replace(newUrl);
        }
    })();

    // --- 多言語全自動リダイレクト（全ページ・404連携対応版） ---
    (function () {
        const path = window.location.pathname;

        // 特定の特殊ページ（例: /connect/ 等）でリダイレクトを除外したい場合の保護
        if (/\/connect(\/|$)/.test(path)) {
            sessionStorage.removeItem('lang_redirected');
            return;
        }

        try {
            if (document.referrer && /\/connect(\/|$)/.test(new URL(document.referrer).pathname)) {
                sessionStorage.removeItem('lang_redirected');
            }
        } catch (e) { }

        // すでに一度リダイレクト判定済みの場合はスキップ（無限ループ防止）
        if (sessionStorage.getItem('lang_redirected')) return;

        // 1. ブラウザの言語を取得 (例: "fr-FR" -> "fr", "zh-CN" -> "zh", "ko-KR" -> "ko")
        var userLang = (navigator.language || navigator.userLanguage || "ja").substring(0, 2).toLowerCase();

        // 2. 現在のURLから言語プレフィックスを取得
        var pathSegments = path.split('/').filter(Boolean);
        var currentLangInUrl = "ja"; // デフォルト（ルート）は日本語

        if (pathSegments.length > 0 && pathSegments[0].length === 2) {
            currentLangInUrl = pathSegments[0];
        }

        // 既に適切な言語のディレクトリにいる場合は処理終了
        if (userLang === currentLangInUrl) {
            sessionStorage.setItem('lang_redirected', 'true');
            return;
        }

        // URL置換用のヘルパー関数
        function buildUrlForLang(targetLang) {
            var origin = window.location.origin;
            var restOfPath = window.location.pathname + window.location.search + window.location.hash;

            if (targetLang === "ja") {
                if (currentLangInUrl !== "ja") {
                    return window.location.href.replace(`/${currentLangInUrl}/`, '/');
                }
                return window.location.href;
            }

            if (currentLangInUrl === "ja") {
                return origin + '/' + targetLang + restOfPath;
            } else {
                return window.location.href.replace(`/${currentLangInUrl}/`, `/${targetLang}/`);
            }
        }

        // 日本語ユーザーの場合はルート(日本語)へリダイレクト
        if (userLang === "ja") {
            var jaUrl = buildUrlForLang("ja");
            if (jaUrl !== window.location.href) {
                sessionStorage.setItem('lang_redirected', 'true');
                window.location.replace(jaUrl);
            }
            return;
        }

        // 3. ページが「実際に存在するか（404.html の内容が返されていないか）」を確認する関数
        function verifyAndGetUrl(targetUrl) {
            return fetch(targetUrl, { method: 'GET' })
                .then(function (response) {
                    if (!response.ok) throw new Error('HTTP status not ok');
                    return response.text();
                })
                .then(function (htmlText) {
                    // 返ってきたHTMLが 404.html (Page Not Found) のものでないか確認
                    var is404Page = htmlText.includes('<title>Page Not Found</title>') || htmlText.includes('<h1>404</h1>');
                    if (is404Page) {
                        throw new Error('404 Page Detected');
                    }

                    return targetUrl;
                });
        }

        // 4. ユーザー言語 -> 英語(en) の順で実在確認して遷移
        var primaryUrl = buildUrlForLang(userLang);
        var fallbackEnUrl = buildUrlForLang("en");

        // ユーザー言語（韓国語など）のページが存在するかGET検証
        verifyAndGetUrl(primaryUrl)
            .then(function (validUrl) {
                sessionStorage.setItem('lang_redirected', 'true');
                window.location.replace(validUrl);
            })
            .catch(function () {
                // ユーザー言語のページが存在しない場合（404.htmlが返された場合含む）
                // 自身が英語でないなら英語(en)のページを検証
                if (userLang !== "en" && currentLangInUrl !== "en") {
                    verifyAndGetUrl(fallbackEnUrl)
                        .then(function (validEnUrl) {
                            sessionStorage.setItem('lang_redirected', 'true');
                            window.location.replace(validEnUrl);
                        })
                        .catch(function () {
                            // 英語ページも存在しない場合はフラグのみ立てて現在のページを維持
                            sessionStorage.setItem('lang_redirected', 'true');
                        });
                } else {
                    sessionStorage.setItem('lang_redirected', 'true');
                }
            });
    })();


    /* =========================================
       1. 共通パーツの自動読み込み (リスト化)
       ========================================= */

    const componentList = [
        { selector: '#sidebar', file: 'sidebar.html' },
        { selector: '#nav', file: 'nav.html' },
        { selector: '#footer', file: 'footer.html' },
        { selector: '#background', file: 'background.html' },
    ];

    componentList.forEach(function (item) {
        const container = document.querySelector(item.selector);

        if (container) {
            const filePath = commonDir + '/' + item.file;

            fetch(filePath)
                .then(response => {
                    if (!response.ok) throw new Error(item.file + ' loading failed');
                    return response.text();
                })
                .then(data => {
                    container.outerHTML = data;

                    // --- ナビゲーションバー特有の処理 ---
                    if (item.file === 'nav.html') {
                        if (window.location.href.indexOf('/connect/') !== -1) {
                            if (window.location.search.indexOf('lang=en') !== -1) {
                                const logoLink = document.getElementById('nav-logo-link');
                                if (logoLink) {
                                    logoLink.setAttribute('onclick', "location.href='/en/'");
                                }
                            }
                        }
                    }

                    // --- サイドバーが挿入された後に WIKI LIST を動的生成 ---
                    if (item.file === 'sidebar.html') {
                        loadWikiListToSidebar();
                    }
                })
                .catch(error => {
                    console.error('パーツの読み込みに失敗しました:', error);
                    if (document.querySelector(item.selector)) {
                        container.innerHTML = '<p style="color:red; padding:10px;">Load Error: ' + item.file + '</p>';
                    }
                });
        }
    });


    /* =========================================
       2. WIKI LIST の動的取得・言語自動補正処理
       ========================================= */
    async function loadWikiListToSidebar() {
        const listContainer = document.getElementById('wiki-list-container');
        if (!listContainer) return;

        // 現在の言語ディレクトリ（/en, /zh など）を判定
        const pathname = window.location.pathname;
        const wikiMatch = pathname.match(/(.*)\/wiki\//);
        const langPrefix = wikiMatch ? wikiMatch[1] : '';

        const targetIndexPath = `${langPrefix}/wiki/index.html`;
        const targetBaseDir = `${langPrefix}/wiki/`;

        try {
            const response = await fetch(targetIndexPath);
            if (!response.ok) throw new Error(`${targetIndexPath} の取得に失敗しました`);

            const htmlText = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(htmlText, 'text/html');
            const accordionItems = doc.querySelectorAll('.accordion-item');

            listContainer.innerHTML = '';

            accordionItems.forEach(item => {
                const clonedItem = item.cloneNode(true);

                // 相対パスの動的書き換え
                const links = clonedItem.querySelectorAll('a');
                links.forEach(a => {
                    const href = a.getAttribute('href');
                    if (href) {
                        if (href.startsWith('./')) {
                            a.setAttribute('href', href.replace('./', targetBaseDir));
                        } else if (href.startsWith('../') && !href.startsWith('http')) {
                            const resolvedUrl = new URL(href, new URL(targetBaseDir, window.location.origin)).pathname;
                            a.setAttribute('href', resolvedUrl);
                        }
                    }
                });

                listContainer.appendChild(clonedItem);
            });

        } catch (error) {
            console.error('Sidebar WIKI LIST load error:', error);
            listContainer.innerHTML = '<p class="text-red-400 text-xs">Failed to load navigation.</p>';
        }
    }


    /* =========================================
       3. サイドバー・アコーディオン開閉 (イベントデリゲーション)
       ========================================= */
    document.addEventListener('click', function (e) {

        // --- A. アコーディオン開閉処理 ---
        const header = e.target.closest('.accordion-header');
        if (header) {
            const accordionItem = header.closest('.accordion-item');
            if (accordionItem) {
                const content = accordionItem.querySelector('.accordion-content');
                const icon = header.querySelector('.fa-chevron-down');

                if (content && icon) {
                    const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
                    if (isOpen) {
                        content.style.maxHeight = '0px';
                        if (icon) icon.style.transform = 'rotate(0deg)';
                    } else {
                        content.style.maxHeight = content.scrollHeight + 'px';
                        if (icon) icon.style.transform = 'rotate(180deg)';
                    }
                }
            }
        }

        // --- B. サイドバー開閉処理 ---
        const sidebarTrigger = e.target.closest('#sidebar-toggle, #sidebar-close, #overlay');
        if (sidebarTrigger) {
            const sidebar = document.querySelector('#sidebar');
            const overlay = document.querySelector('#overlay');

            if (!sidebar) return;

            sidebar.classList.toggle('-translate-x-full');

            if (sidebar.classList.contains('-translate-x-full')) {
                if (overlay) overlay.classList.add('hidden');
            } else {
                if (overlay) overlay.classList.remove('hidden');
            }
        }
    });
});